{
  "name": "certrotator",
  "version": "1.0.0",
  "description": "SSL certificate rotation tool: scan, renew, deploy, verify, audit",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "demo": "node demo/localDemo.js",
    "bootstrap": "node src/cli.js bootstrap --validity-days 1",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "dev:client": "npm --prefix client run dev"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "acme-client": "^5.4.0",
    "better-sqlite3": "^11.0.0",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "node-forge": "^1.3.1"
  }
}
